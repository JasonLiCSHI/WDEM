{
  "schemaVersion": 1,
  "id": "csharp-developer",
  "version": "2.0.0",
  "displayName": "Visual Studio Professional + ReSharper",
  "description": "A focused Visual Studio Professional 2026 workstation with ReSharper and managed configuration.",
  "tasks": {
    "visual-studio-professional": {
      "displayName": "Visual Studio Professional 2026",
      "description": "Installs Visual Studio Professional from Microsoft and applies the bundled .vsconfig during setup.",
      "required": true,
      "dependsOn": [],
      "version": ">= 18.9.2",
      "preferredVersion": "18.9.2",
      "source": "https://aka.ms/vs/18/stable/vs_professional.exe",
      "detect": {
        "displayName": "Check Visual Studio Professional version",
        "executable": "powershell.exe",
        "arguments": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "{appDirectory}\\script\\Invoke-VisualStudioProfessionalTask.ps1",
          "-Action",
          "Detect"
        ],
        "versionPattern": "Visual Studio Professional version (?<version>\\d+(?:\\.\\d+)+)"
      },
      "pre": [
        {
          "displayName": "Validate Visual Studio source, host state, and configuration",
          "executable": "powershell.exe",
          "arguments": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "{appDirectory}\\script\\Invoke-VisualStudioProfessionalTask.ps1",
            "-Action",
            "Pre",
            "-SourceUri",
            "{source}",
            "-ConfigPath",
            "{appDirectory}\\settings\\.vsconfig"
          ]
        }
      ],
      "apply": {
        "displayName": "Install Visual Studio Professional with .vsconfig",
        "executable": "powershell.exe",
        "arguments": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "{appDirectory}\\script\\Invoke-VisualStudioProfessionalTask.ps1",
          "-Action",
          "Apply",
          "-SourceUri",
          "{source}",
          "-ConfigPath",
          "{appDirectory}\\settings\\.vsconfig"
        ]
      },
      "post": [
        {
          "displayName": "Verify declared Visual Studio components",
          "executable": "powershell.exe",
          "arguments": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "{appDirectory}\\script\\Invoke-VisualStudioProfessionalTask.ps1",
            "-Action",
            "Post",
            "-ConfigPath",
            "{appDirectory}\\settings\\.vsconfig"
          ]
        }
      ]
    },
    "resharper": {
      "displayName": "JetBrains ReSharper",
      "description": "Installs ReSharper from JetBrains for Visual Studio Professional 2026 and applies the bundled global settings.",
      "required": true,
      "dependsOn": ["visual-studio-professional"],
      "version": ">= 2026.1.0.1",
      "preferredVersion": "2026.2.1",
      "source": "https://download.jetbrains.com/resharper/dotUltimate.2026.2.1/JetBrains.ReSharper.2026.2.1.web.exe",
      "detect": {
        "displayName": "Check ReSharper version",
        "executable": "powershell.exe",
        "arguments": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "{appDirectory}\\script\\Invoke-ReSharperTask.ps1",
          "-Action",
          "Detect"
        ],
        "versionPattern": "JetBrains ReSharper version (?<version>\\d+(?:\\.\\d+)+)"
      },
      "pre": [
        {
          "displayName": "Validate ReSharper source, integrity, and Visual Studio host",
          "executable": "powershell.exe",
          "arguments": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "{appDirectory}\\script\\Invoke-ReSharperTask.ps1",
            "-Action",
            "Pre",
            "-SourceUri",
            "{source}",
            "-Sha256",
            "c1f330ff9d9faafcf46c13b646a4b8e09acfe982c7e9de4e9a5fae2ac7f15fc8"
          ]
        }
      ],
      "apply": {
        "displayName": "Install ReSharper silently",
        "executable": "powershell.exe",
        "arguments": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "{appDirectory}\\script\\Invoke-ReSharperTask.ps1",
          "-Action",
          "Apply",
          "-SourceUri",
          "{source}",
          "-Sha256",
          "c1f330ff9d9faafcf46c13b646a4b8e09acfe982c7e9de4e9a5fae2ac7f15fc8"
        ]
      },
      "post": [
        {
          "displayName": "Apply ReSharper global settings",
          "executable": "powershell.exe",
          "arguments": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "{appDirectory}\\script\\Apply-ReSharperSettings.ps1",
            "-SettingsPath",
            "{appDirectory}\\settings\\CT.DotSettings"
          ]
        }
      ]
    }
  }
}
