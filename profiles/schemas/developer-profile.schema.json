{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JasonLiCSHI/WDEM/profiles/schemas/developer-profile.schema.json",
  "title": "WDEM developer profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "resources"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "profile": { "$ref": "#/$defs/profile" },
    "resources": {
      "type": "object",
      "propertyNames": { "pattern": "\\S" },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "displayName", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "version": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "requiredResources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resourceReference" },
          "default": []
        },
        "optionalResources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resourceReference" },
          "default": []
        }
      }
    },
    "resourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "versionConstraint": { "type": "string", "minLength": 1 },
        "preferredVersion": { "type": "string", "minLength": 1 },
        "defaultSelected": { "type": "boolean", "default": false }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "description", "type", "provider"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "type": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "versionConstraint": { "type": "string", "minLength": 1 },
        "preferredVersion": { "type": "string", "minLength": 1 },
        "privilegeRequirement": {
          "type": "string",
          "enum": ["CurrentUser", "Administrator"],
          "default": "CurrentUser"
        },
        "restartPolicy": {
          "type": "string",
          "enum": ["NoRestart", "RestartRecommended", "RestartRequired"],
          "default": "NoRestart"
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] },
          "default": {}
        }
      }
    }
  }
}
