<Window x:Class="Wdem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WDEM">
    <NavigationView x:Name="RootNavigation"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Left"
                    SelectionChanged="NavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="ProfilesNavigationItem" Content="配置文件" Tag="profiles" />
            <NavigationViewItem x:Name="ResourcesNavigationItem"
                                Content="资源"
                                Tag="resources"
                                IsEnabled="{Binding CanNavigateToResources}" />
        </NavigationView.MenuItems>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="PageHost" Grid.Row="0" />
            <TextBlock Grid.Row="1"
                       Margin="24,12,24,24"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       VerticalAlignment="Bottom" />
        </Grid>
    </NavigationView>
</Window>
