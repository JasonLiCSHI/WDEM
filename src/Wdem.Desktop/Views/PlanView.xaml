<UserControl x:Class="Wdem.Desktop.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="18">
            <TextBlock Text="执行计划" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="检查每项资源的操作、权限、重启策略和依赖关系后再应用。"
                       TextWrapping="Wrap" />

            <ProgressRing IsActive="{Binding IsLoading}" HorizontalAlignment="Left" />

            <StackPanel Spacing="8">
                <TextBlock Text="执行层" FontSize="20" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Layers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ResourcesDisplay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="资源操作" FontSize="20" FontWeight="SemiBold" />
                <ListView ItemsSource="{Binding Resources}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,4" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Id}" Opacity="0.7" />
                                    <TextBlock Text="{Binding ProviderDisplay}" />
                                    <TextBlock Text="{Binding ActionDisplay}" />
                                    <TextBlock Text="{Binding PrivilegeDisplay}" />
                                    <TextBlock Text="{Binding RestartPolicyDisplay}" />
                                    <TextBlock Text="{Binding DependenciesLabel}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusDisplay}" />
                                    <TextBlock Text="{Binding Error}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="不可执行错误" FontSize="20" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="重新检查" Command="{Binding InspectCommand}" />
                <Button Content="应用计划"
                        Command="{Binding ApplyCommand}"
                        IsEnabled="{Binding CanApply}"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
